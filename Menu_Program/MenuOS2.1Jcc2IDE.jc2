}
else if(select2==1) {
messagebox("Music Player's root option","Ok","Back","Music Player has 4 built-in musics but in options menu, there is 'Open from Root' option which you can load other mp3 format files! but the only limitation for this feature is the 15sec limit duration.");
}
else if(select2==2) {
