sleep(1000);
while(c.getKeyStates()==0) {
g.setColor(0xf0f0f0);
g.fillRect(0,0,w,h);
g.drawImage(img,0,0,Graphics.LEFT|Graphics.TOP);
g.setColor(0x000000);
