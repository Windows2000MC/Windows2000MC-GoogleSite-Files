g.setColor(0xffffff);
g.drawString("Press any key to return",10,300,Graphics.LEFT|Graphics.TOP);
g.setColor(0xfff000);
g.fillRect(0,275,240,0);
g.setColor(0x000000);
g.drawString("Free Memory - "+freeMemory(),10,280,Graphics.LEFT|Graphics.TOP);
