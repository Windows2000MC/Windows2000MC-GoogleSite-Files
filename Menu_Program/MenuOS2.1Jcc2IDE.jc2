void main()
{
	println("Log info -");
println("Main System starting...");
println("MenuOS is booting...");
int w=240;
int h=320;
Canvas c=new Canvas();
Graphics g=c.getGraphics();
while(c.getKeyStates()==0) {
c.show();
c.fullscreen(true);
g.setColor(0x000000);
g.fillRect(0,0,w,h);
sleep(1000);
g.setColor(0xffffff);
g.fillRect(0,0,w,h);
g.setColor(0x000000);
g.drawString("Windows2000MC",60,h/2,Graphics.LEFT|Graphics.TOP);
g.drawString("Jcc2 Reloaded",70,300,Graphics.LEFT|Graphics.TOP);
c.repaint();
sleep(2500);
int prog=1;
while(prog==prog) {
g.setColor(0xffffff);
g.fillRect(0,0,w,h);
g.setColor(0x000000);
g.drawString("MenuOS",90,h/2,Graphics.LEFT|Graphics.TOP);
g.setColor(0x000fff);
g.fillRect(0,295,prog,320);
g.setColor(0xffffff);
g.drawString("Loading...",90,300,Graphics.LEFT|Graphics.TOP);
prog=prog+1;
c.repaint();
if(prog==240) {
while(h==h) {
string timez=""+getTime(Time.HOUR_OF_DAY);
timez=timez+":"+getTime(Time.MINUTE);
timez=timez+":"+getTime(Time.SECOND);
g.setColor(0xffffff);
g.fillRect(0,0,w,h);
g.setColor(0x000000);
g.fillRect(0,0,240,25);
g.setColor(0xffffff);
g.drawString(timez,175,5,Graphics.LEFT|Graphics.TOP);
g.drawString("Robi",10,5,Graphics.LEFT|Graphics.TOP);
g.setColor(0x000000);
g.drawString("Menu",100,300,Graphics.LEFT|Graphics.TOP);
g.drawString("Exit",10,300,Graphics.LEFT|Graphics.TOP);
g.drawLine(0,295,240,295);
c.repaint();
if(c.getKey()==-6) {
c.show();
g.setColor(0x000000);
g.fillRect(0,295,240,320);
g.setColor(0xffffff);
g.drawString("Exit",10,300,Graphics.LEFT|Graphics.TOP);
c.repaint();
sleep(100);
g.setColor(0x000fff);
g.fillRect(0,25,240,35);
g.setColor(0xffffff);
g.drawString("Aborting...",90,30,Graphics.LEFT|Graphics.TOP);
c.repaint();
sleep(500);
println("Graphics closing...");
g.setColor(0x000000);
g.fillRect(0,0,w,h);
c.repaint();
sleep(2000);
println("MenuOS is aborted...");
return;
}
else if(c.getKey()==-5) {
while(w==w) {
g.setColor(0x000000);
g.fillRect(0,295,240,320);
g.setColor(0xffffff);
g.drawString("Menu",100,300,Graphics.LEFT|Graphics.TOP);
c.repaint();
sleep(100);
g.setColor(0x000fff);
g.fillRect(0,25,240,30);
g.setColor(0xffffff);
g.drawString("Loading...",85,30,Graphics.LEFT|Graphics.TOP);
c.repaint();
sleep(500);
string[] menu={"Music Player","Image Viewer","Tools","Settings","Games"};
int select=selectform("Menu "+timez,"Open","Options",menu);
if(select==-1) {
string[] option={"Links","Help","Support us","Exit"};
