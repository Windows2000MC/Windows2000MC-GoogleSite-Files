if(select5==1) {
messagebox("About Image Viewer","OK","Back","Image Viewer v1.1\n\nJSR 75 FileConnection API for root (only inside the jar's resources)\nJ2ME Basic Graphics API for view image\n\nSource code engine - Menu Program v2.0");
}
else if(select5==2) {
}
else if(select5==0) { 
c.show();
g.setColor(0xf0f0f0);
